# =============================================================================
# GMPT Bot 环境变量配置
# =============================================================================

# ── 单实例模式（向后兼容） ──
# 设置 BOT_ROLE 指定角色，使用 DISCORD_TOKEN
# BOT_ROLE=full
# DISCORD_TOKEN=你的Bot_Token填这里

# ── 多实例模式（新）：同时运行多个 Bot 角色，共享 data.db ──
# 不设置 BOT_ROLE 即为多实例模式，每个角色需要独立 TOKEN
# 启动命令: python main.py
# 首次启动会自动检测并合并 data*.db 旧数据库（合并后旧文件重命名为 .bak）
TOKEN_FULL=xxx
TOKEN_ECONOMY=xxx
TOKEN_COMMUNITY=xxx
TOKEN_ARENA=xxx
TOKEN_GAMBLING=xxx

# ── 通用配置 ──
DB_PATH=data.db
BACKUP_CHANNEL_ID=xxx
BACKUP_INTERVAL=300
AUTO_RESTORE=0
RIOT_API_KEY=
PORT=8080